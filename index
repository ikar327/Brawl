<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Trener Draftu — Brawl Stars</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lilita+One&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#15122a;--bg2:#1d1838;--panel:#241e44;--panel2:#2c2554;
    --ink:#f5f1ff;--muted:#a99fd6;
    --gold:#ffc83d;--pink:#ff3d7f;--cyan:#2de2ff;--lime:#b6ff3d;
    --ok:#39d98a;--bad:#ff5c6c;--line:rgba(255,255,255,.10);
    --sT:#ff5c6c;--aT:#ffc83d;--bT:#2de2ff;--cT:#9b8fd0;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:'Outfit',sans-serif;color:var(--ink);
    background:
      radial-gradient(900px 600px at 12% -5%, rgba(255,61,127,.22), transparent 60%),
      radial-gradient(800px 600px at 95% 0%, rgba(45,226,255,.18), transparent 55%),
      radial-gradient(700px 700px at 50% 120%, rgba(182,255,61,.10), transparent 60%),
      linear-gradient(180deg, var(--bg), var(--bg2));
    background-attachment:fixed;min-height:100vh;-webkit-font-smoothing:antialiased;
    padding:18px 14px 60px;
  }
  body::before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.05;z-index:0;
    background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
    background-size:34px 34px}
  .wrap{max-width:640px;margin:0 auto;position:relative;z-index:1}
  header{text-align:center;margin-bottom:14px}
  .kicker{font-size:11px;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);font-weight:700;margin-bottom:6px}
  h1{font-family:'Lilita One',cursive;font-weight:400;line-height:.95;font-size:clamp(32px,10vw,52px);
    letter-spacing:.5px;text-shadow:0 4px 0 rgba(0,0,0,.35),0 0 32px rgba(255,61,127,.35)}
  h1 .b{color:var(--pink)}
  .sub{color:var(--muted);font-size:13px;margin-top:7px}
  .stamp{font-size:11px;color:var(--muted);background:rgba(45,226,255,.08);border:1px solid rgba(45,226,255,.25);
    border-radius:10px;padding:7px 11px;margin:12px auto 0;max-width:520px;line-height:1.5}
  .stamp b{color:var(--cyan)}

  .tabs{display:flex;flex-wrap:wrap;gap:6px;margin:16px 0;background:rgba(0,0,0,.22);
    padding:6px;border-radius:16px;border:1px solid var(--line)}
  .tab{flex:1 1 auto;border:0;cursor:pointer;font-family:'Lilita One',cursive;font-size:13.5px;
    color:var(--muted);background:transparent;padding:11px 8px;border-radius:11px;transition:.18s;letter-spacing:.3px;white-space:nowrap}
  .tab.active{color:#1a1430;background:linear-gradient(180deg,var(--gold),#f5a623);box-shadow:0 5px 0 #b4790f}
  .tab:not(.active):hover{color:var(--ink);background:rgba(255,255,255,.05)}

  .view{display:none;animation:rise .35s ease both}
  .view.active{display:block}
  @keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}

  .card{background:linear-gradient(180deg,var(--panel),var(--panel2));border:1px solid var(--line);
    border-radius:22px;padding:20px;box-shadow:0 18px 40px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.06)}

  /* trainer */
  .meta{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
  .badge{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;padding:5px 10px;border-radius:999px;border:1px solid var(--line)}
  .badge.mode{color:var(--cyan);background:rgba(45,226,255,.10)}
  .badge.topic{color:var(--lime);background:rgba(182,255,61,.10)}
  .q{font-family:'Lilita One',cursive;font-size:21px;line-height:1.2;margin-bottom:16px}
  .opts{display:flex;flex-direction:column;gap:10px}
  .opt{text-align:left;cursor:pointer;font:inherit;font-size:15px;font-weight:600;color:var(--ink);
    background:rgba(255,255,255,.04);border:1.5px solid var(--line);border-radius:14px;padding:13px 15px;
    transition:.15s;display:flex;gap:10px;align-items:center}
  .opt .ltr{font-family:'Lilita One',cursive;color:var(--gold);flex:0 0 auto}
  .opt:hover:not(:disabled){border-color:var(--gold);background:rgba(255,200,61,.06);transform:translateX(2px)}
  .opt:disabled{cursor:default}
  .opt.correct{border-color:var(--ok);background:rgba(57,217,138,.14)} .opt.correct .ltr{color:var(--ok)}
  .opt.wrong{border-color:var(--bad);background:rgba(255,92,108,.14)} .opt.wrong .ltr{color:var(--bad)}
  .explain{margin-top:14px;border-left:3px solid var(--cyan);background:rgba(45,226,255,.07);padding:12px 14px;
    border-radius:0 12px 12px 0;font-size:14.5px;line-height:1.5;display:none}
  .explain.show{display:block;animation:rise .25s ease both} .explain b{color:var(--cyan)}
  .barwrap{height:8px;background:rgba(0,0,0,.3);border-radius:999px;margin:16px 0 4px;overflow:hidden}
  .bar{height:100%;width:0;background:linear-gradient(90deg,var(--pink),var(--gold));transition:.4s;border-radius:999px}
  .row{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:13px;font-weight:600}
  .btn{font-family:'Lilita One',cursive;font-size:16px;letter-spacing:.3px;cursor:pointer;border:0;color:#1a1430;
    background:linear-gradient(180deg,var(--lime),#7cdb16);padding:13px 22px;border-radius:14px;box-shadow:0 6px 0 #4f8f0c;transition:.12s;width:100%;margin-top:16px}
  .btn:active{transform:translateY(4px);box-shadow:0 2px 0 #4f8f0c}
  .btn.pink{background:linear-gradient(180deg,var(--pink),#d61f5e);box-shadow:0 6px 0 #8e0f3c;color:#fff}
  .btn.pink:active{box-shadow:0 2px 0 #8e0f3c}
  .btn.ghost{background:rgba(255,255,255,.06);color:var(--ink);box-shadow:none;border:1.5px solid var(--line)}
  .btn.ghost:active{transform:translateY(2px)}
  .score-final{text-align:center;padding:10px 0}
  .score-final .big{font-family:'Lilita One',cursive;font-size:60px;color:var(--gold);line-height:1;text-shadow:0 0 28px rgba(255,200,61,.4)}
  .score-final .lbl{color:var(--muted);margin:6px 0 4px} .score-final .msg{font-size:15px;margin-top:8px}

  /* section heads */
  .sec{margin-bottom:22px} .sec:last-child{margin-bottom:0}
  .sec h2{font-family:'Lilita One',cursive;font-size:20px;margin-bottom:12px;color:var(--gold)}
  .sec h2 .em{font-size:18px;margin-right:6px}
  .lead{font-size:13.5px;color:var(--muted);line-height:1.5;margin-bottom:14px}

  /* tier list */
  .tierrow{display:flex;gap:10px;margin-bottom:10px;align-items:stretch}
  .tierlabel{flex:0 0 52px;border-radius:12px;display:flex;align-items:center;justify-content:center;
    font-family:'Lilita One',cursive;font-size:26px;color:#1a1430}
  .tier-S{background:linear-gradient(160deg,#ff8a96,var(--sT))}
  .tier-A{background:linear-gradient(160deg,#ffe08a,var(--aT))}
  .tier-B{background:linear-gradient(160deg,#9af0ff,var(--bT))}
  .tier-C{background:linear-gradient(160deg,#bcb2e0,var(--cT))}
  .tierbox{flex:1;background:rgba(0,0,0,.18);border:1px solid var(--line);border-radius:12px;padding:9px;display:flex;flex-wrap:wrap;gap:6px;align-content:flex-start}
  .pill{font-size:12.5px;font-weight:700;padding:5px 10px;border-radius:9px;background:rgba(255,255,255,.07);border:1px solid var(--line)}
  .pill.hot{background:rgba(255,61,127,.16);border-color:rgba(255,61,127,.4);color:#ffd0e0}

  .modechips{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
  .mchip{cursor:pointer;font:inherit;font-size:13px;font-weight:700;color:var(--muted);background:rgba(255,255,255,.05);
    border:1.5px solid var(--line);border-radius:10px;padding:8px 12px;transition:.15s}
  .mchip.active{color:#1a1430;background:var(--cyan);border-color:var(--cyan)}
  .picklist{display:flex;flex-wrap:wrap;gap:7px}
  .pickitem{display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.04);border:1px solid var(--line);
    border-radius:11px;padding:9px 12px;font-weight:700;font-size:14px;flex:1 1 46%;min-width:130px}
  .pickitem .rank{font-family:'Lilita One',cursive;color:var(--gold);font-size:15px}

  /* maps */
  .maptype{border:1px solid var(--line);border-radius:14px;padding:13px 15px;margin-bottom:10px;background:rgba(255,255,255,.03)}
  .maptype .mt{font-family:'Lilita One',cursive;font-size:16px;color:var(--cyan);margin-bottom:4px}
  .maptype .desc{font-size:13px;color:var(--muted);line-height:1.45;margin-bottom:8px}
  .maptype .recs{font-size:13.5px;line-height:1.5} .maptype .recs b{color:var(--gold)}
  .maptype .ex{font-size:12px;color:var(--muted);margin-top:6px}
  .mapcard{border:1px solid var(--line);border-radius:13px;padding:11px 14px;margin-bottom:9px;background:rgba(255,255,255,.03)}
  .mapcard .mn{font-family:'Lilita One',cursive;font-size:14.5px}
  .mapcard .mtag{font-size:10.5px;color:var(--cyan);text-transform:uppercase;letter-spacing:.08em;font-weight:700}
  .mapcard .mp{font-size:13.5px;color:var(--ink);line-height:1.45;margin-top:4px} .mapcard .mp b{color:var(--gold)}

  /* counters */
  .selwrap{position:relative;margin-bottom:14px}
  select.bsel{width:100%;font:inherit;font-size:15px;font-weight:700;color:var(--ink);background:rgba(0,0,0,.3);
    border:1.5px solid var(--line);border-radius:13px;padding:13px 14px;appearance:none;-webkit-appearance:none}
  .selwrap::after{content:"▾";position:absolute;right:16px;top:50%;transform:translateY(-50%);color:var(--gold);pointer-events:none;font-size:14px}
  .counterout{display:none;animation:rise .25s ease both}
  .counterout.show{display:block}
  .cohead{font-family:'Lilita One',cursive;font-size:22px;margin-bottom:4px}
  .corole{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;font-weight:700;margin-bottom:14px}
  .colab{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--pink);margin:0 0 8px}
  .cobrawlers{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:14px}
  .cob{font-size:13.5px;font-weight:700;padding:7px 12px;border-radius:10px;background:rgba(57,217,138,.12);border:1px solid rgba(57,217,138,.35);color:#bdf5d8}
  .conote{border-left:3px solid var(--gold);background:rgba(255,200,61,.07);padding:11px 14px;border-radius:0 12px 12px 0;font-size:14px;line-height:1.5}

  ul.clean{list-style:none;display:flex;flex-direction:column;gap:9px}
  ul.clean li{background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:12px;padding:11px 14px;font-size:14px;line-height:1.45}
  ul.clean li b{color:var(--gold)}
  ul.dont li b{color:var(--bad)}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:rgba(255,255,255,.03);flex:1 1 46%;min-width:150px}
  .chip .t{font-family:'Lilita One',cursive;font-size:15px} .chip .d{font-size:12.5px;color:var(--muted);margin-top:3px;line-height:1.4}
  .triangle{display:grid;gap:10px}
  .tnode{display:flex;align-items:center;gap:12px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
  .tnode .arr{font-family:'Lilita One',cursive;color:var(--gold);font-size:18px;flex:0 0 auto}
  .tnode .txt{font-size:14px;line-height:1.4} .tnode .txt b{font-family:'Lilita One',cursive;font-weight:400}
  .modegrid{display:flex;flex-direction:column;gap:10px}
  .mrow{border:1px solid var(--line);border-radius:14px;padding:12px 14px;background:rgba(255,255,255,.03)}
  .mrow .mt{font-family:'Lilita One',cursive;font-size:15px;color:var(--cyan);margin-bottom:3px}
  .mrow .md{font-size:13.5px;line-height:1.45}

  /* draft sim */
  .drow{display:flex;gap:10px}
  .dcol{flex:1}
  .dcol label{display:block;font-size:11px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:6px}
  .sidebtns{display:flex;gap:8px;margin-top:10px}
  .mapinfo{font-size:12.5px;color:var(--muted);line-height:1.5;margin-top:10px;background:rgba(45,226,255,.07);border:1px solid rgba(45,226,255,.2);border-radius:11px;padding:10px 12px}
  .mapinfo b{color:var(--cyan)}
  .sb{flex:1;font-family:'Lilita One',cursive;font-size:12.5px;border:0;cursor:pointer;border-radius:12px;padding:11px 6px;color:#1a1430;transition:.12s}
  .sb.mine{background:linear-gradient(180deg,var(--lime),#7cdb16);box-shadow:0 4px 0 #4f8f0c}
  .sb.enemy{background:linear-gradient(180deg,#ff8a96,var(--bad));box-shadow:0 4px 0 #9e2c38;color:#fff}
  .sb.ban{background:rgba(255,255,255,.08);border:1.5px solid var(--line);color:var(--ink)}
  .sb:active{transform:translateY(2px)}
  .board{display:flex;gap:8px;margin-bottom:16px}
  .bcol{flex:1;background:rgba(0,0,0,.18);border:1px solid var(--line);border-radius:14px;padding:10px;min-height:64px}
  .bh{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-bottom:8px;display:flex;justify-content:space-between;gap:4px}
  .bh.mine{color:var(--lime)} .bh.enemy{color:#ff9aa6} .bh.ban{color:var(--muted)}
  .bchips{display:flex;flex-direction:column;gap:6px}
  .bchip{font-size:12.5px;font-weight:700;background:rgba(255,255,255,.06);border:1px solid var(--line);border-radius:9px;padding:7px 9px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:6px}
  .bchip .x{color:var(--bad);font-weight:800}
  .bchip.ban{text-decoration:line-through;opacity:.65}
  .recnote{border-left:3px solid var(--gold);background:rgba(255,200,61,.08);padding:11px 14px;border-radius:0 12px 12px 0;font-size:13.5px;line-height:1.5;margin-bottom:14px}
  .recnote b{color:var(--gold)}
  .rech{font-family:'Lilita One',cursive;font-size:16px;color:var(--cyan);margin:22px 0 12px;padding-top:16px;border-top:1px solid var(--line)}
  .rech.ban{color:#ff9aa6}
  .hint{font-size:11.5px;color:var(--muted);font-style:italic;margin:8px 0 0}
  .rec{display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:13px;padding:11px 13px;margin-bottom:8px}
  .rec .rank{font-family:'Lilita One',cursive;color:var(--gold);font-size:18px;flex:0 0 auto;width:18px;text-align:center}
  .rec .info{flex:1;min-width:0}
  .rec .nm{font-family:'Lilita One',cursive;font-size:16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
  .rec .meta2{font-size:12px;color:var(--muted);margin-top:3px;line-height:1.4}
  .rec .meta2 .beat{color:#bdf5d8}
  .tierbadge{font-size:9.5px;font-weight:800;padding:3px 6px;border-radius:6px;color:#1a1430}
  .tb-S{background:var(--sT);color:#fff} .tb-A{background:var(--aT)} .tb-B{background:var(--bT)} .tb-C{background:var(--cT)}
  .banrec{font-size:13px;color:var(--ink);background:rgba(255,92,108,.1);border:1px solid rgba(255,92,108,.3);border-radius:12px;padding:11px 13px;margin-top:6px;line-height:1.5}
  .banrec b{color:#ff9aa6}
  .vs{margin-bottom:14px;background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:13px;padding:11px 13px}
  .vsh{font-family:'Lilita One',cursive;font-size:15px;color:#ff9aa6;margin-bottom:8px}
  .vstip{font-size:12px;color:var(--muted);line-height:1.45;margin:2px 0 0 2px}
  .vs .cobrawlers{margin-bottom:4px}

  /* flashcards */
  .fc-stage{perspective:1200px;margin-bottom:16px}
  .fc{position:relative;width:100%;min-height:240px;cursor:pointer;transform-style:preserve-3d;transition:transform .5s cubic-bezier(.4,.2,.2,1)}
  .fc.flip{transform:rotateY(180deg)}
  .fc-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:22px;display:flex;flex-direction:column;
    align-items:center;justify-content:center;padding:26px;text-align:center;border:1.5px solid var(--line)}
  .fc-front{background:linear-gradient(160deg,var(--panel2),var(--panel))}
  .fc-back{background:linear-gradient(160deg,#2a2350,#352b66);transform:rotateY(180deg)}
  .fc-tag{font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;margin-bottom:14px}
  .fc-front .fc-tag{color:var(--pink)} .fc-back .fc-tag{color:var(--lime)}
  .fc-q{font-family:'Lilita One',cursive;font-size:23px;line-height:1.15}
  .fc-a{font-size:16px;line-height:1.5}
  .fc-hint{position:absolute;bottom:12px;left:0;right:0;text-align:center;font-size:11px;color:var(--muted)}
  .fc-controls{display:flex;gap:10px} .fc-controls .btn{margin-top:0}
  .fc-meta{display:flex;justify-content:space-between;color:var(--muted);font-size:13px;font-weight:600;margin-bottom:12px} .fc-meta .known{color:var(--ok)}
  .addbar{display:flex;gap:8px;margin-top:14px}
  .addbar input{flex:1;min-width:0;font:inherit;font-size:13.5px;color:var(--ink);background:rgba(0,0,0,.25);border:1px solid var(--line);border-radius:11px;padding:11px 12px}
  .addbar input::placeholder{color:var(--muted)}
  .addbar button{font-family:'Lilita One',cursive;border:0;cursor:pointer;color:#1a1430;background:var(--gold);border-radius:11px;padding:0 16px;font-size:14px}

  .note{font-size:12px;color:var(--muted);background:rgba(255,200,61,.08);border:1px solid rgba(255,200,61,.25);border-radius:12px;padding:11px 13px;margin-top:14px;line-height:1.5}
  .foot{text-align:center;color:var(--muted);font-size:11.5px;margin-top:26px;line-height:1.6}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="kicker">Ranked · Faza Ban / Pick</div>
    <h1>Trener <span class="b">Draftu</span></h1>
    <div class="sub">Brawl Stars — draft jak na poradnikach BobbysBS + meta Kairosa</div>
    <div class="stamp">Meta: tier lista i picki per tryb wg <b>FRVR (akt. 20 maja 2026)</b> · kontry i mapy — snapshot z <b>1 czerwca 2026</b> · w stylu <b>Kairos Pro Tier List V51</b>. Meta zmienia się z patchami — dane są edytowalne w kodzie.</div>
  </header>

  <nav class="tabs">
    <button class="tab active" data-view="draft">Draft</button>
    <button class="tab" data-view="tier">Tier lista</button>
    <button class="tab" data-view="maps">Mapy</button>
    <button class="tab" data-view="counters">Kontry</button>
    <button class="tab" data-view="cheat">Ściąga</button>
    <button class="tab" data-view="cards">Fiszki</button>
  </nav>

  <!-- DRAFT SIM -->
  <section class="view active" id="draft">
    <div class="card">
      <div class="sec" style="margin-bottom:16px">
        <h2><span class="em">🎮</span>Symulator draftu</h2>
        <div class="lead">Ustaw tryb i typ mapy, potem dodawaj picki w kolejności, w jakiej padają (Twoje / wroga / bany). Po każdym ruchu podpowiem najlepszy następny pick i co rozważyć do bana.</div>
        <div class="dcol"><label>Mapa</label><div class="selwrap"><select class="bsel" id="dMap"></select></div></div>
        <div class="mapinfo" id="mapInfo"></div>
      </div>
      <div class="sec" style="margin-bottom:16px">
        <div class="selwrap"><select class="bsel" id="dPick"></select></div>
        <div class="sidebtns">
          <button class="sb mine" data-side="mine">+ Moja drużyna</button>
          <button class="sb enemy" data-side="enemy">+ Wróg</button>
          <button class="sb ban" data-side="bans">+ Ban</button>
        </div>
      </div>
      <div class="board">
        <div class="bcol"><div class="bh mine">Ty <span id="cMine">0/3</span></div><div class="bchips" id="lMine"></div></div>
        <div class="bcol"><div class="bh enemy">Wróg <span id="cEnemy">0/3</span></div><div class="bchips" id="lEnemy"></div></div>
        <div class="bcol"><div class="bh ban">Bany</div><div class="bchips" id="lBans"></div></div>
      </div>
      <div id="recBox"></div>
      <button class="btn pink" id="dReset">Reset draftu</button>
    </div>
  </section>

  <!-- TIER LIST -->
  <section class="view" id="tier">
    <div class="card">
      <div class="sec">
        <h2><span class="em">🏆</span>Tier lista (meta)</h2>
