const fcPos=document.getElementById('fcPos'),fcTotal=document.getElementById('fcTotal'),fcKnown=document.getElementById('fcKnown');
function buildDeck(){deck=shuffle([...BASE_CARDS,...extraCards]);fcIdx=0;known=new Set();renderCard();}
function renderCard(){if(!deck.length)return;fc.classList.remove('flip');const c=deck[fcIdx];fcQ.textContent=c.q;fcA.textContent=c.a;
  fcPos.textContent=fcIdx+1;fcTotal.textContent=deck.length;fcKnown.textContent=known.size;}
