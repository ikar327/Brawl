        const tb=c.tier?'<span class="tierbadge tb-'+c.tier+'">'+c.tier+'</span>':'';
        const rs=c.reasons.length?c.reasons.join(' · '):(c.role||'');
        html+='<div class="rec"><div class="rank">'+(i+1)+'</div><div class="info"><div class="nm">'+c.b+' '+tb+'</div><div class="meta2">'+(c.role?c.role+' · ':'')+rs+'</div></div></div>';
      });
    }

    box.innerHTML=html;
  }

  function render(){renderInfo();renderBoard();renderRec();}

  document.querySelectorAll('.sb').forEach(btn=>btn.addEventListener('click',()=>{
    const side=btn.dataset.side,b=dPick.value;
    if(used().has(b))return;
    if((side==='mine'||side==='enemy')&&state[side].length>=3)return;
    if(side==='bans'&&state.bans.length>=6)return;
    state[side].push(b);render();
  }));
  document.getElementById('dReset').addEventListener('click',()=>{state.mine=[];state.enemy=[];state.bans=[];render();});
  dMap.addEventListener('change',render);
  render();
})();
</script>
</body>
</html>
